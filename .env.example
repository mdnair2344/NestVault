# Copy this file to ".env" and fill in your own values. Never share or commit .env
MONGODB_URI=
DB_NAME=
PORT=3000

# Access passwords used on the sign-up form (choose your own, keep them secret).
# ADMIN_CODE: needed to register the ONE administrator account. EDITOR_CODE: needed to register an editor.
# Viewers need no password. If a code is empty, sign-up for that role is switched off.
ADMIN_CODE=
EDITOR_CODE=

# Recommended when deploying (any long random string). Required if NODE_ENV=production.
JWT_SECRET=
CRON_SECRET

# Optional: keep backups on a SEPARATE cluster (second Atlas project/cluster)
BACKUP_MONGODB_URI=
BACKUP_DB_NAME=

# Optional limits and targets
QUOTA_MB=100
MAX_FILE_MB=25
VERSIONS_KEEP=20
INTEGRITY_HOURS=6
RTO_TARGET_MIN=5
RPO_TARGET_MIN=5
# LOG=off   (turn off request logging)

# Optional: public address of the app (used in password-reset and verification links)
APP_URL=
# Optional: send mail through any service that accepts a JSON POST {to, subject, text}.
# Without it, the message (with its link) is printed in the server console.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_AUTH=


SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APP_URL=http://localhost:3000
